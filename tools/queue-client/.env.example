# Șablon pentru tools/queue-client/.env. Copiază-l și completează valorile:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# Toate cele 7 variabile sunt obligatorii, fără valori implicite: una lipsă sau goală
# oprește comanda cu codul de ieșire 2 și numește variabila. Tabelul complet:
# docs/06-setup-orchestrator.md, secțiunea 11.
#
# Valorile stau între apostrofuri simple, pentru că secretul poate conține $.
# .env este ignorat de git (vezi .gitignore). Secretul stă în password manager;
# în faza 3 trece în hel, lângă celelalte secrete ale recepției.
# Valorile de mai jos între { } și < > sunt șabloane: clientul le refuză ca atare.

# Doar schema și hostul, fără organizație.
UIPATH_CLOUD_URL='https://cloud.uipath.com'

# Numele organizației, așa cum apare în URL-ul Orchestrator.
UIPATH_ORG='{org}'

# Numele tenantului. Schimbă-l dacă tenantul nu este cel implicit.
UIPATH_TENANT='DefaultTenant'

# App ID al aplicației externe ScanExpert-Receptie-Dispatcher (docs/06 secțiunea 8).
UIPATH_CLIENT_ID='<client-id>'

# App Secret al aceleiași aplicații. Nu îl pune în git și nu îl trimite pe chat.
UIPATH_CLIENT_SECRET='<client-secret>'

# Folderul Orchestrator, trimis ca header X-UIPATH-FolderPath.
UIPATH_FOLDER_PATH='PixelData'

# Coada în care intră itemii.
UIPATH_QUEUE_NAME='PixelData_Programari'
